# Client ID de Google AdSense (formato: ca-pub-XXXXXXXXXXXXXXXX).
# Déjalo vacío hasta tener la cuenta de AdSense aprobada: si está vacío,
# el sitio no inyecta el script de AdSense ni renderiza los <AdSlot />.
PUBLIC_ADSENSE_CLIENT_ID=

# ID de medición de Google Analytics (formato: G-XXXXXXXXXX).
# Déjalo vacío para no cargar el gtag. Si está vacío, el sitio no
# inyecta ningún script de Analytics.
PUBLIC_GA_MEASUREMENT_ID=

# Llave pública de Wompi (formato: pub_test_... en sandbox, pub_prod_... en
# producción). Se usa en el navegador para renderizar el widget de pago, así
# que sí puede ser pública. Sin esto, el botón "Comprar" de /plantillas/
# muestra un error en vez de abrir el pago.
PUBLIC_WOMPI_PUBLIC_KEY=

# --- Variables que NO van aquí, van en la configuración de Functions de
# --- Cloudflare Pages (nunca en el build de Astro, son secretas):
# WOMPI_INTEGRITY_SECRET  → secreto de integridad de tu cuenta Wompi
# WOMPI_ENV               → "sandbox" mientras pruebas, vacío/"production" cuando ya cobres de verdad
