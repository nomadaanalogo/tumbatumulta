---
import Icon from './Icon.astro';

interface Props {
  continueLabel?: string;
}

const { continueLabel } = Astro.props;
---

<dialog
  id="donate-modal"
  class="fixed inset-0 m-auto w-[90vw] max-w-sm rounded-3xl border-0 p-0 shadow-2xl backdrop:bg-slate-900/60 backdrop:backdrop-blur-sm dark:bg-slate-900"
>
  <div class="p-6 text-center">
    <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-linear-to-br from-pink-500 to-rose-500 text-white shadow-md shadow-pink-500/30">
      <Icon name="heart" size={22} strokeWidth={1.8} />
    </span>
    <p class="mt-4 text-sm font-semibold text-slate-500 dark:text-slate-400">
      Llave Bre-B, entidad Nubank:
    </p>

    <div class="mt-3 flex items-center justify-between gap-2 rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 dark:border-slate-700 dark:bg-slate-800">
      <span id="donate-key" class="font-mono text-base font-semibold text-slate-900 dark:text-white">@jov309</span>
      <button
        type="button"
        id="copy-donate-key"
        class="inline-flex shrink-0 items-center gap-1.5 rounded-lg bg-linear-to-br from-pink-500 to-rose-500 px-3 py-1.5 text-xs font-semibold text-white shadow-sm shadow-pink-500/30 transition-transform hover:scale-105"
      >
        <Icon name="copy" size={14} strokeWidth={2} />
        <span id="copy-donate-key-label">Copiar</span>
      </button>
    </div>

    <p class="mt-4 text-sm leading-relaxed text-slate-700 dark:text-slate-300">
      Tu aporte mantiene este sitio y ayuda a más personas a cuidar su bolsillo.
    </p>

    <p class="mt-2 flex items-center justify-center gap-1.5 text-sm font-semibold text-pink-600 dark:text-pink-400">
      <Icon name="heart" size={14} strokeWidth={2} />
      Gracias por tu apoyo
    </p>

    {
      continueLabel && (
        <button
          type="button"
          id="donate-modal-continue"
          class="mt-5 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-slate-900 px-4 py-3 text-sm font-semibold text-white transition-colors hover:bg-slate-800 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-200"
        >
          {continueLabel}
        </button>
      )
    }

    <button
      type="button"
      id="close-donate-modal"
      class="mt-4 text-sm font-semibold text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200"
    >
      Cerrar
    </button>
  </div>
</dialog>

<script>
  const modal = document.getElementById('donate-modal') as HTMLDialogElement | null;
  const openBtn = document.getElementById('open-donate-modal');
  const closeBtn = document.getElementById('close-donate-modal');
  const continueBtn = document.getElementById('donate-modal-continue');
  const copyBtn = document.getElementById('copy-donate-key');
  const copyLabel = document.getElementById('copy-donate-key-label');
  const keyEl = document.getElementById('donate-key');

  openBtn?.addEventListener('click', () => modal?.showModal());
  closeBtn?.addEventListener('click', () => modal?.close());
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) modal.close();
  });

  continueBtn?.addEventListener('click', () => {
    modal?.close();
    document.dispatchEvent(new CustomEvent('donate-modal-continue'));
  });

  copyBtn?.addEventListener('click', async () => {
    if (!keyEl || !copyLabel) return;
    try {
      await navigator.clipboard.writeText(keyEl.textContent ?? '');
      const original = copyLabel.textContent;
      copyLabel.textContent = '¡Copiado!';
      setTimeout(() => {
        copyLabel.textContent = original;
      }, 2000);
    } catch {
      copyLabel.textContent = 'No se pudo copiar';
    }
  });
</script>
