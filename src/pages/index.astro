---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import poseDedo from '../imagenes/pose_dedo_arriba.png';
import posePulgar from '../imagenes/pose_pulgar_arriba.png';
import expAaa from '../imagenes/exp_aaa.png';
import expVamos from '../imagenes/exp_vamos.png';
import expOjo from '../imagenes/exp_ojo.png';
import CopyBox from '../components/CopyBox.astro';
import DonateModal from '../components/DonateModal.astro';
import { AI_PROMPT } from '../data/ai-prompt';
import { SITE_NAME } from '../consts';

type LinkItem = { href: string; title: string; description: string; icon: IconName };

const featured: LinkItem[] = [
  {
    href: '/blog/caducidad-vs-prescripcion-multas-transito/',
    title: 'Caducidad vs. prescripción: la diferencia que más dinero te puede ahorrar',
    description: 'Son dos figuras distintas y casi nadie las explica bien. Aquí sabrás cuál aplica a tu caso.',
    icon: 'clock',
  },
  {
    href: '/blog/no-pagues-tu-multa-de-transito/',
    title: 'No pagues tu multa de tránsito sin hacer esto primero',
    description: 'Los 5 escenarios reales en los que la ley colombiana dice que no estás obligado a pagar.',
    icon: 'check-circle',
  },
  {
    href: '/blog/como-tumbar-una-multa-de-transito-en-colombia/',
    title: 'Cómo tumbar o anular una multa de tránsito',
    description: 'Guía rápida en 5 pasos: qué revisar primero y cuándo el proceso es rápido de verdad.',
    icon: 'shield-check',
  },
  {
    href: '/blog/simit-vs-runt-diferencias/',
    title: 'SIMIT: cómo consultar tu multa por placa o cédula',
    description: 'El paso a paso para consultar el portal oficial, y qué hacer con lo que encuentres antes de pagar.',
    icon: 'search',
  },
  {
    href: '/blog/que-es-el-cobro-coactivo-en-colombia/',
    title: '¿Qué es el cobro coactivo en Colombia?',
    description: 'Cómo funciona el proceso con el que el Estado cobra sin pasar por un juez, y tus opciones.',
    icon: 'lock',
  },
  {
    href: '/blog/caso-tumbar-multa-transito-mas-de-6-anos/',
    title: 'Caso ilustrativo: así se tumba una multa de más de 6 años',
    description: 'Derecho de petición, un segundo intento, tutela, y por qué al final se cayó el cobro.',
    icon: 'sparkles',
  },
];

const nextSteps: LinkItem[] = [
  {
    href: '/plantillas/',
    title: 'Plantillas gratis de derecho de petición y tutela',
    description: 'Si la IA te dice que tienes un argumento, aquí tienes el documento listo para llenar.',
    icon: 'document',
  },
  {
    href: '/blog/derecho-de-peticion-transito/',
    title: 'Cómo presentar el derecho de petición',
    description: 'A quién se lo envías, qué pedir y cuánto tiempo tienen para responderte.',
    icon: 'mail',
  },
  {
    href: '/blog/tutela-derecho-peticion-no-respondido/',
    title: 'Si no te responden: la tutela',
    description: 'Qué hacer cuando el organismo de tránsito ignora tu petición.',
    icon: 'scale',
  },
];

const title = SITE_NAME;
const description =
  'Antes de pagar tu multa de tránsito en Colombia, entiende tus opciones: prescripción, caducidad, fotomultas mal notificadas y derecho de petición. Guía gratuita y clara.';
---

<BaseLayout title={title} description={description}>
  <div class="relative isolate overflow-hidden">
    <!-- Decorative background: warm gradient mesh + faint grid -->
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-20 bg-linear-to-b from-orange-50 via-white to-white dark:from-slate-900 dark:via-slate-950 dark:to-slate-950"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -left-40 -top-40 -z-10 h-112 w-md rounded-full bg-orange-400/35 blur-3xl dark:bg-orange-600/20"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-40 -top-24 -z-10 h-120 w-120 rounded-full bg-amber-300/45 blur-3xl dark:bg-amber-500/15"></div>
    <div aria-hidden="true" class="pointer-events-none absolute left-1/3 top-96 -z-10 h-80 w-80 rounded-full bg-rose-300/30 blur-3xl dark:bg-rose-600/10"></div>
    <div aria-hidden="true" class="hero-grid pointer-events-none absolute inset-x-0 top-0 -z-10 h-160 text-orange-900/[0.06] dark:text-white/5"></div>

    <section id="analiza" class="mx-auto max-w-2xl scroll-mt-6 px-4 pb-32 pt-8 sm:px-6 sm:pt-12">
      <div class="flex items-end gap-3 sm:gap-5">
        <h1 class="flex-1 text-[2rem] font-extrabold leading-[1.08] tracking-tight text-slate-900 dark:text-white sm:text-5xl">
          Antes de{' '}
          <span class="bg-linear-to-r from-red-600 to-rose-500 bg-clip-text text-transparent line-through decoration-red-600 decoration-[3px]">pagar tu multa de tránsito</span>,{' '}
          <span class="bg-linear-to-r from-green-600 via-emerald-500 to-teal-500 bg-clip-text text-transparent dark:from-green-400 dark:via-emerald-300 dark:to-teal-300">evalúa tus opciones.</span>
        </h1>
        <div class="relative shrink-0">
          <div aria-hidden="true" class="absolute inset-x-1 bottom-3 top-10 -z-10 rounded-full bg-linear-to-br from-orange-300 to-amber-200 opacity-70 blur-2xl dark:from-orange-500/50 dark:to-amber-400/40"></div>
          <Image
            src={poseDedo}
            alt="Tumba, el cono abogado de TumbaTuMulta"
            widths={[110, 176, 352]}
            sizes="(min-width: 640px) 176px, 110px"
            loading="eager"
            class="w-27.5 drop-shadow-xl sm:w-44"
          />
        </div>
      </div>

      <div class="mt-8 flex items-center gap-2 rounded-2xl bg-linear-to-r from-yellow-300 via-yellow-400 to-amber-400 py-2 pl-2 pr-4 text-slate-900 shadow-xl shadow-amber-500/30 ring-1 ring-inset ring-white/60 sm:gap-3 sm:pr-5">
        <Image
          src={expAaa}
          alt=""
          widths={[84, 112, 224]}
          sizes="(min-width: 640px) 112px, 84px"
          class="-mb-2 -mt-8 w-21 shrink-0 self-end sm:w-28"
        />
        <p class="py-2 text-lg font-extrabold leading-snug sm:text-xl">
          No hagas acuerdos de pago ni te dejes presionar.
        </p>
      </div>

      <ul class="mt-6 flex flex-wrap gap-2">
        {
          ['La ley te respalda', 'No necesitas abogado', 'La IA te ayuda gratis'].map((chip) => (
            <li class="inline-flex items-center gap-1.5 rounded-full bg-white/80 px-3.5 py-1.5 text-sm font-semibold text-slate-800 shadow-sm ring-1 ring-slate-900/5 backdrop-blur dark:bg-slate-900/70 dark:text-slate-200 dark:ring-white/10">
              <Icon name="check-circle" size={16} strokeWidth={2.2} class="text-emerald-600 dark:text-emerald-400" />
              {chip}
            </li>
          ))
        }
      </ul>

      <div class="mt-8 rounded-[1.75rem] bg-linear-to-br from-orange-400 via-amber-300 to-rose-400 p-0.5 shadow-2xl shadow-orange-500/20 dark:shadow-orange-900/30">
        <div class="overflow-hidden rounded-[calc(1.75rem-2px)] bg-white dark:bg-slate-950">
          <div class="relative flex items-center gap-3 overflow-hidden bg-linear-to-r from-slate-950 via-slate-900 to-slate-800 px-5 py-3.5 text-white">
            <div aria-hidden="true" class="absolute -right-10 -top-10 h-32 w-32 rounded-full bg-orange-500/40 blur-2xl"></div>
            <span class="relative flex h-8 w-8 items-center justify-center rounded-lg bg-linear-to-br from-orange-500 to-amber-400 shadow-md shadow-orange-500/40">
              <Icon name="robot" size={18} strokeWidth={2} />
            </span>
            <p class="relative font-bold">Analiza tu multa con IA en 3 pasos</p>
          </div>

          <ol class="relative p-5 text-base text-slate-700 dark:text-slate-300 sm:p-6">
            <span aria-hidden="true" class="absolute bottom-10 left-[2.15rem] top-10 w-px bg-linear-to-b from-slate-300 via-orange-300 to-slate-300 sm:left-[2.4rem] dark:from-slate-700 dark:via-orange-800 dark:to-slate-700"></span>
            <li class="relative flex gap-3 pb-4">
              <span class="step-num">1</span>
              <span class="pt-0.5">
                <strong class="text-slate-900 dark:text-white">Copia</strong> el{' '}
                <button type="button" id="copy-prompt-shortcut" class="font-semibold text-slate-900 underline decoration-orange-400 decoration-2 underline-offset-4 hover:decoration-orange-600 dark:text-white">prompt de abajo</button>.
              </span>
            </li>
            <li class="relative flex gap-3 pb-4">
              <span class="step-num">2</span>
              <span class="pt-0.5"><strong class="text-slate-900 dark:text-white">Pégalo</strong> en ChatGPT, Gemini o Claude.</span>
            </li>
            <li class="relative flex gap-3">
              <span class="step-num">3</span>
              <span class="pt-0.5">
                <strong class="text-slate-900 dark:text-white">Adjunta el pantallazo</strong> de tu registro en el{' '}
                <a href="https://www.fcm.org.co/simit/#/home-public" target="_blank" rel="noopener noreferrer" class="font-semibold text-slate-900 underline decoration-orange-400 decoration-2 underline-offset-4 hover:decoration-orange-600 dark:text-white">SIMIT</a>.
              </span>
            </li>
          </ol>

          <div class="border-t border-slate-100 bg-linear-to-b from-slate-50 to-white p-4 dark:border-slate-800 dark:from-slate-900/60 dark:to-slate-950 sm:p-5">
            <CopyBox id="ai-prompt-home" text={AI_PROMPT} maxHeight="max-h-48 sm:max-h-56" />
          </div>
        </div>
      </div>

      <p class="mt-3 text-sm text-slate-600 dark:text-slate-400">
        100% gratis · sin registro · no reemplaza a un abogado en casos de alto valor.
      </p>

      <div class="mt-6 flex flex-col gap-4 rounded-3xl bg-linear-to-br from-pink-100 via-rose-50 to-orange-50 p-5 shadow-lg shadow-pink-500/10 ring-1 ring-pink-200/70 sm:flex-row sm:items-center sm:justify-between dark:from-pink-950/50 dark:via-rose-950/30 dark:to-slate-950 dark:ring-pink-900/60">
        <div class="flex items-center gap-3">
          <Image
            src={posePulgar}
            alt=""
            widths={[60, 120]}
            sizes="60px"
            class="-my-3 w-15 shrink-0"
          />
          <div>
            <p class="font-bold text-slate-900 dark:text-white">¿Te ayudamos? Apóyanos</p>
            <p class="mt-0.5 text-sm leading-relaxed text-slate-700 dark:text-slate-300">
              Este sitio es gratis y se mantiene con donaciones. Cualquier aporte ayuda a más personas.
            </p>
          </div>
        </div>
        <button
          type="button"
          id="open-donate-modal"
          class="inline-flex shrink-0 items-center justify-center gap-2 rounded-full bg-linear-to-r from-pink-500 via-rose-500 to-orange-400 px-6 py-2.5 text-sm font-bold text-white shadow-lg shadow-pink-500/30 transition-all hover:-translate-y-0.5 hover:shadow-xl hover:shadow-pink-500/40"
        >
          <Icon name="heart" size={16} strokeWidth={2.2} />
          Donar
        </button>
      </div>

      <div class="mt-6 flex gap-3 rounded-2xl bg-linear-to-br from-amber-50 to-yellow-50 p-4 ring-1 ring-amber-200 dark:from-amber-950/40 dark:to-slate-950 dark:ring-amber-900">
        <Icon name="alert-triangle" size={20} class="mt-0.5 shrink-0 text-amber-600 dark:text-amber-400" />
        <p class="text-sm leading-relaxed text-amber-900 dark:text-amber-200">
          <strong>Una excepción honesta:</strong> si tu comparendo es por <strong>embriaguez o alcoholemia</strong>,
          esto no aplica igual. Hay una prueba técnica directa y consecuencias que van más allá de una multa
          administrativa, así que no recomendamos buscar defectos de forma. <strong>Consulta con un abogado.</strong>
        </p>
      </div>
    </section>
  </div>

  <section class="relative bg-linear-to-b from-white to-orange-50/60 dark:from-slate-950 dark:to-slate-900">
    <div aria-hidden="true" class="absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent via-orange-300 to-transparent dark:via-orange-800"></div>
    <div class="relative mx-auto max-w-2xl px-4 pb-32 pt-14 sm:px-6">
      <Image
        src={expVamos}
        alt=""
        widths={[112, 140, 280]}
        sizes="(min-width: 640px) 140px, 112px"
        class="pointer-events-none absolute right-4 top-0 w-28 -translate-y-full sm:right-6 sm:w-35"
      />
      <p class="section-pill">Siguiente paso</p>
      <h2 class="mt-3 text-2xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-3xl">Después de la respuesta de la IA</h2>
      <p class="mt-2 text-base text-slate-700 dark:text-slate-300">
        Actúa dentro de los plazos legales: perderlos es lo que más le cuesta a la gente.
      </p>
      <ul class="mt-6 space-y-3">
        {
          nextSteps.map((item) => (
            <li>
              <a
                href={item.href}
                class="group flex items-start gap-4 rounded-2xl bg-white/90 p-4 shadow-sm ring-1 ring-slate-900/5 backdrop-blur transition-all hover:-translate-y-0.5 hover:shadow-lg hover:shadow-orange-500/10 hover:ring-orange-300 dark:bg-slate-900/80 dark:ring-white/10 dark:hover:ring-orange-700"
              >
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-linear-to-br from-orange-500 to-amber-400 text-white shadow-md shadow-orange-500/30 transition-transform group-hover:scale-105">
                  <Icon name={item.icon} size={20} strokeWidth={1.9} />
                </span>
                <span class="flex-1">
                  <span class="block font-bold text-slate-900 group-hover:text-orange-700 dark:text-white dark:group-hover:text-orange-400">{item.title}</span>
                  <span class="mt-1 block text-base text-slate-600 dark:text-slate-400">{item.description}</span>
                </span>
                <Icon name="arrow-right" size={18} strokeWidth={2} class="mt-3 shrink-0 text-slate-400 transition-transform group-hover:translate-x-1 group-hover:text-orange-600" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="relative bg-linear-to-b from-slate-50 to-white dark:from-slate-900 dark:to-slate-950">
    <div aria-hidden="true" class="absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent via-orange-300 to-transparent dark:via-orange-800"></div>
    <div class="relative mx-auto max-w-2xl px-4 py-14 sm:px-6">
      <Image
        src={expOjo}
        alt=""
        widths={[112, 140, 280]}
        sizes="(min-width: 640px) 140px, 112px"
        class="pointer-events-none absolute right-4 top-0 w-28 -translate-y-full sm:right-6 sm:w-35"
      />
      <p class="section-pill">Aprende más</p>
      <h2 class="mt-3 text-2xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-3xl">Los artículos más buscados</h2>
      <ul class="mt-6 divide-y divide-slate-100 rounded-3xl bg-white px-4 shadow-sm ring-1 ring-slate-900/5 sm:px-5 dark:divide-slate-800 dark:bg-slate-900 dark:ring-white/10">
        {
          featured.map((post) => (
            <li>
              <a href={post.href} class="group flex items-start gap-4 py-4">
                <span class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-orange-50 text-orange-700 transition-all group-hover:bg-linear-to-br group-hover:from-orange-500 group-hover:to-amber-400 group-hover:text-white group-hover:shadow-md group-hover:shadow-orange-500/30 dark:bg-orange-950/60 dark:text-orange-300">
                  <Icon name={post.icon} size={18} strokeWidth={1.9} />
                </span>
                <span>
                  <span class="block font-bold text-slate-900 group-hover:text-orange-700 dark:text-white dark:group-hover:text-orange-400">{post.title}</span>
                  <span class="mt-1 block text-base text-slate-600 dark:text-slate-400">{post.description}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
        <a href="#analiza" class="inline-flex items-center gap-2 rounded-full bg-linear-to-r from-orange-600 via-orange-500 to-amber-500 px-6 py-3 text-sm font-bold text-white shadow-lg shadow-orange-500/30 transition-all hover:-translate-y-0.5 hover:shadow-xl hover:shadow-orange-500/40">
          <Icon name="robot" size={18} strokeWidth={2} />
          Analizar mi multa con IA
        </a>
        <a href="/blog/" class="inline-flex items-center gap-1 font-bold text-orange-700 hover:underline dark:text-orange-400">
          Ver todos los artículos
          <Icon name="arrow-right" size={16} strokeWidth={2} />
        </a>
      </div>
    </div>
  </section>

  <button
    type="button"
    data-open-donate
    aria-label="Donar"
    class="fixed bottom-[calc(1rem+var(--cookie-offset,0px))] left-4 z-40 inline-flex items-center gap-2 rounded-full bg-linear-to-r from-pink-500 via-rose-500 to-orange-400 py-3 pl-3 pr-4 text-sm font-bold text-white shadow-lg shadow-pink-500/40 ring-2 ring-white/70 transition-all hover:-translate-y-0.5 hover:scale-105 sm:bottom-[calc(1.5rem+var(--cookie-offset,0px))] sm:left-6 dark:ring-slate-900/70"
  >
    <Icon name="heart" size={20} strokeWidth={2.2} class="heart-beat" />
    Donar
  </button>

  <DonateModal />
</BaseLayout>

<style>
  .hero-grid {
    background-image:
      linear-gradient(to right, currentColor 1px, transparent 1px),
      linear-gradient(to bottom, currentColor 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 0%, black, transparent);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 0%, black, transparent);
  }

  .step-num {
    display: flex;
    height: 1.75rem;
    width: 1.75rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background-image: linear-gradient(135deg, #334155, #020617);
    font-size: 0.875rem;
    font-weight: 700;
    color: white;
    box-shadow: 0 0 0 4px white, 0 4px 10px -2px rgb(2 6 23 / 0.35);
  }
  @media (prefers-color-scheme: dark) {
    .step-num {
      background-image: linear-gradient(135deg, #ffffff, #e2e8f0);
      color: #0f172a;
      box-shadow: 0 0 0 4px #020617;
    }
  }

  .section-pill {
    display: inline-flex;
    border-radius: 9999px;
    background-image: linear-gradient(90deg, #ea580c, #f59e0b);
    padding: 0.25rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: white;
    box-shadow: 0 4px 12px -4px rgb(234 88 12 / 0.5);
  }

  @keyframes heart-beat {
    0%, 70%, 100% { transform: scale(1); }
    80% { transform: scale(1.25); }
    90% { transform: scale(0.95); }
  }
  :global(.heart-beat) {
    animation: heart-beat 2.4s ease-in-out infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.heart-beat) { animation: none; }
  }
</style>

<script>
  const shortcutBtn = document.getElementById('copy-prompt-shortcut');
  const realCopyBtn = document.querySelector<HTMLButtonElement>('[data-copy-target="ai-prompt-home"]');
  const promptEl = document.getElementById('ai-prompt-home');

  document.querySelector<HTMLAnchorElement>('a[href="#analiza"]')?.addEventListener('click', (event) => {
    event.preventDefault();
    document.getElementById('analiza')?.scrollIntoView({ behavior: 'smooth' });
  });

  shortcutBtn?.addEventListener('click', async () => {
    promptEl?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    if (!promptEl) return;
    try {
      await navigator.clipboard.writeText(promptEl.textContent ?? '');
      const original = shortcutBtn.textContent;
      shortcutBtn.textContent = '¡Copiado!';
      setTimeout(() => {
        shortcutBtn.textContent = original;
      }, 2000);
    } catch {
      realCopyBtn?.click();
    }
  });
</script>
