---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import CopyBox from '../components/CopyBox.astro';
import { AI_PROMPT } from '../data/ai-prompt';
import { SITE_NAME } from '../consts';

const featured: { href: string; title: string; description: string; icon: IconName }[] = [
  {
    href: '/blog/simit-vs-runt-diferencias/',
    title: 'SIMIT: cómo consultar tu multa por placa o cédula',
    description: 'El paso a paso para consultar el portal oficial, y qué hacer con lo que encuentres antes de pagar.',
    icon: 'search',
  },
  {
    href: '/blog/como-tumbar-una-multa-de-transito-en-colombia/',
    title: 'Cómo tumbar o anular una multa de tránsito',
    description: 'Guía rápida en 5 pasos: qué revisar primero y cuándo el proceso es rápido de verdad.',
    icon: 'shield-check',
  },
  {
    href: '/blog/recursos-reposicion-apelacion-comparendo/',
    title: 'Cómo impugnar una multa de tránsito',
    description: 'Los recursos de reposición y apelación, formalmente, y los plazos que no te puedes saltar.',
    icon: 'scale',
  },
  {
    href: '/blog/multas-de-transito-en-colombia-guia-completa/',
    title: 'Multas de tránsito en Colombia: guía completa',
    description: 'El mapa general: qué es una multa, cómo consultarla, y cuándo la ley te respalda para no pagarla.',
    icon: 'document',
  },
  {
    href: '/blog/no-pagues-tu-multa-de-transito/',
    title: 'No pagues tu multa de tránsito sin hacer esto primero',
    description: 'Los 5 escenarios reales en los que la ley colombiana dice que no estás obligado a pagar.',
    icon: 'check-circle',
  },
  {
    href: '/blog/caso-tumbar-multa-transito-mas-de-6-anos/',
    title: 'Caso ilustrativo: así se tumba una multa de más de 6 años',
    description: 'Derecho de petición, un segundo intento, tutela, y por qué al final se cayó el cobro.',
    icon: 'sparkles',
  },
  {
    href: '/blog/caducidad-vs-prescripcion-multas-transito/',
    title: 'Caducidad vs. prescripción: la diferencia que más dinero te puede ahorrar',
    description:
      'Son dos figuras distintas y casi nadie las explica bien. Aquí sabrás cuál aplica a tu caso.',
    icon: 'clock',
  },
  {
    href: '/blog/que-es-el-cobro-coactivo-en-colombia/',
    title: '¿Qué es el cobro coactivo en Colombia?',
    description: 'Cómo funciona el proceso con el que el Estado cobra sin pasar por un juez, y tus opciones.',
    icon: 'lock',
  },
  {
    href: '/blog/tipos-de-multas-de-transito-en-colombia/',
    title: 'Tipos de multas de tránsito en Colombia',
    description: 'Velocidad, semáforo, parqueo, documentos, alcoholemia: qué tan defendible es cada una.',
    icon: 'camera',
  },
];

const steps: { icon: IconName; title: string; description: string }[] = [
  {
    icon: 'robot',
    title: '1. Analiza tu multa con IA',
    description:
      'Copia el prompt de arriba en ChatGPT, Gemini o Claude junto con el pantallazo del SIMIT para una <strong>recomendación puntual sobre tu caso</strong>.',
  },
  {
    icon: 'search',
    title: '2. Profundiza si lo necesitas',
    description:
      'Lee los artículos relevantes a tu situación: <strong>fecha del comparendo</strong>, tipo de infracción, si te notificaron o no.',
  },
  {
    icon: 'check-circle',
    title: '3. Actúa a tiempo',
    description:
      'Presenta un derecho de petición, una excepción o un recurso <strong>dentro de los plazos legales</strong> — perderlos es lo que más le cuesta a la gente.',
  },
];

const title = SITE_NAME;
const description =
  'Antes de pagar tu multa de tránsito en Colombia, entiende tus opciones: prescripción, caducidad, fotomultas mal notificadas y derecho de petición. Guía gratuita y clara.';
---

<BaseLayout title={title} description={description}>
  <section class="mx-auto max-w-3xl px-4 pb-16 pt-14 text-center sm:px-6 sm:pt-20">
    <p class="text-xl font-semibold text-slate-600 dark:text-slate-300 sm:text-2xl">
      Antes de <span class="inline-block -rotate-1 text-red-600 line-through decoration-1 dark:text-red-400">pagar tu multa de tránsito</span>
    </p>
    <h1 class="mt-1 text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
      evalúa tus opciones.
    </h1>

    <p class="relative mt-5 inline-flex items-center gap-1.5 text-sm font-bold uppercase tracking-wide text-red-600 dark:text-red-400">
      <span class="absolute inset-x-1 -bottom-1.5 h-2 rounded-full bg-red-500/50 blur-md" />
      <Icon name="alert-triangle" size={15} strokeWidth={2.2} class="relative" />
      <span class="relative">No hagas acuerdos de pago todavía</span>
    </p>

    <p class="mx-auto mt-4 max-w-xl text-lg leading-relaxed text-slate-600 dark:text-slate-300">
      <strong class="bg-linear-to-r from-blue-600 via-sky-500 to-indigo-500 bg-clip-text text-transparent dark:from-blue-400 dark:via-sky-300 dark:to-indigo-400">La ley te respalda</strong> y
      no necesitas abogado —
      <br class="sm:hidden" />
      <strong class="bg-linear-to-r from-blue-600 via-sky-500 to-indigo-500 bg-clip-text text-transparent dark:from-blue-400 dark:via-sky-300 dark:to-indigo-400">la IA te ayuda gratis</strong>.
    </p>

    <div class="mx-auto mt-10 max-w-2xl overflow-hidden rounded-3xl border-2 border-blue-400 bg-white text-left shadow-xl shadow-blue-500/20 dark:border-blue-500 dark:bg-slate-950 dark:shadow-blue-500/10">
      <div class="grid divide-y divide-slate-100 border-b border-slate-100 sm:grid-cols-4 sm:divide-x sm:divide-y-0 dark:divide-slate-800 dark:border-slate-800">
        <div class="flex items-center gap-3 p-4 sm:flex-col sm:items-start sm:gap-2">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-linear-to-br from-blue-500 to-indigo-500 text-sm font-bold text-white shadow-sm shadow-blue-500/30">1</span>
          <p class="text-sm leading-snug text-slate-700 dark:text-slate-300">
            <strong class="text-slate-900 dark:text-white">Copia</strong> el{' '}
            <button type="button" id="copy-prompt-shortcut" class="font-bold text-slate-900 underline decoration-emerald-400 decoration-2 underline-offset-2 dark:text-white">prompt</button>{' '}de abajo
          </p>
        </div>
        <div class="flex items-center gap-3 p-4 sm:flex-col sm:items-start sm:gap-2">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-linear-to-br from-blue-500 to-indigo-500 text-sm font-bold text-white shadow-sm shadow-blue-500/30">2</span>
          <p class="text-sm leading-snug text-slate-700 dark:text-slate-300"><strong class="text-slate-900 dark:text-white">Pégalo</strong> en ChatGPT, Gemini o Claude</p>
        </div>
        <div class="flex items-center gap-3 p-4 sm:flex-col sm:items-start sm:gap-2">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-linear-to-br from-blue-500 to-indigo-500 text-sm font-bold text-white shadow-sm shadow-blue-500/30">3</span>
          <p class="text-sm leading-snug text-slate-700 dark:text-slate-300">
            <strong class="text-slate-900 dark:text-white">Adjunta el pantallazo</strong> de tu registro en el{' '}
            <a href="https://www.fcm.org.co/simit/#/home-public" target="_blank" rel="noopener noreferrer" class="underline hover:text-emerald-700 dark:hover:text-emerald-400">SIMIT</a>
          </p>
        </div>
        <div class="flex items-center gap-3 p-4 sm:flex-col sm:items-start sm:gap-2">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-linear-to-br from-emerald-500 to-green-600 text-sm font-bold text-white shadow-sm shadow-emerald-500/30">4</span>
          <p class="text-sm leading-snug text-slate-700 dark:text-slate-300">
            Si te ayudamos, <strong class="text-slate-900 dark:text-white">no olvides apoyarnos</strong>
          </p>
          <button
            type="button"
            id="open-donate-modal"
            class="mt-1 inline-flex items-center gap-1.5 text-sm font-semibold text-pink-600 underline dark:text-pink-400"
          >
            <Icon name="heart" size={14} strokeWidth={2} />
            Dona aquí
          </button>
        </div>
      </div>

      <div class="bg-slate-50/60 p-4 dark:bg-slate-900/40 sm:p-5">
        <CopyBox id="ai-prompt-home" text={AI_PROMPT} />
      </div>
    </div>

    <p class="mt-4 text-xs text-slate-500 dark:text-slate-500">
      100% gratis · sin registro · no reemplaza a un abogado en casos de alto valor
    </p>

    <div class="mx-auto mt-10 flex max-w-2xl gap-3 rounded-2xl border border-amber-200 bg-linear-to-br from-amber-50 to-orange-50 p-5 text-left shadow-sm shadow-amber-900/5 dark:border-amber-900 dark:from-amber-950/40 dark:to-orange-950/20">
      <Icon name="alert-triangle" size={22} class="mt-0.5 shrink-0 text-amber-600 dark:text-amber-400" />
      <p class="text-sm leading-relaxed text-amber-900 dark:text-amber-200">
        <strong>Una excepción honesta:</strong> si tu comparendo es por <strong>embriaguez o alcoholemia</strong>,
        esto no aplica igual. Ese tipo de infracción tiene una <strong>prueba técnica directa</strong> y
        consecuencias que van más allá de una multa administrativa — no es un caso donde recomendemos buscar
        defectos de forma para no pagar. Si es tu situación, <strong>consulta directamente con un abogado</strong>.
      </p>
    </div>
  </section>

  <section class="border-t border-slate-200 bg-linear-to-b from-slate-50 to-white dark:border-slate-800 dark:from-slate-900 dark:to-slate-950">
    <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">Los artículos más buscados</h2>
      <div class="mt-8 grid gap-5 sm:grid-cols-2">
        {
          featured.map((post) => (
            <a
              href={post.href}
              class="group flex gap-4 rounded-2xl border border-slate-200/70 bg-white p-6 shadow-sm shadow-slate-900/5 transition-all hover:-translate-y-0.5 hover:border-indigo-200 hover:shadow-lg hover:shadow-indigo-500/10 dark:border-slate-800 dark:bg-slate-900 dark:hover:border-indigo-900"
            >
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-linear-to-br from-indigo-500 to-violet-500 text-white shadow-sm shadow-indigo-500/30 transition-transform group-hover:scale-105">
                <Icon name={post.icon} size={20} strokeWidth={1.8} />
              </span>
              <div>
                <h3 class="font-semibold text-slate-900 dark:text-white">{post.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400">{post.description}</p>
              </div>
            </a>
          ))
        }
      </div>
      <div class="mt-8">
        <a
          href="/blog/"
          class="inline-flex items-center gap-1 text-sm font-semibold text-indigo-600 hover:underline dark:text-indigo-400"
        >
          Ver todos los artículos de la guía
          <Icon name="arrow-right" size={16} strokeWidth={2} />
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
    <div class="grid gap-8 sm:grid-cols-3">
      {
        steps.map((step) => (
          <div>
            <span
              class:list={[
                'flex h-11 w-11 items-center justify-center rounded-xl text-white shadow-sm',
                step.icon === 'robot' && 'bg-linear-to-br from-emerald-400 to-teal-500 shadow-emerald-500/30',
                step.icon === 'search' && 'bg-linear-to-br from-indigo-500 to-violet-500 shadow-indigo-500/30',
                step.icon === 'check-circle' && 'bg-linear-to-br from-sky-400 to-cyan-500 shadow-cyan-500/30',
              ]}
            >
              <Icon name={step.icon} size={20} strokeWidth={1.8} />
            </span>
            <h3 class="mt-4 font-semibold text-slate-900 dark:text-white">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400" set:html={step.description} />
          </div>
        ))
      }
    </div>

    <div class="mt-12 text-center">
      <a
        href="#top"
        onclick="window.scrollTo({top:0,behavior:'smooth'});return false;"
        class="inline-flex items-center gap-2 rounded-full bg-linear-to-r from-emerald-500 to-teal-500 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-emerald-500/25 transition-all hover:-translate-y-0.5 hover:shadow-xl hover:shadow-emerald-500/30"
      >
        <Icon name="robot" size={18} strokeWidth={2} />
        Copiar el prompt y analizar mi multa
      </a>
    </div>
  </section>

  <dialog
    id="donate-modal"
    class="fixed inset-0 m-auto w-[90vw] max-w-sm rounded-3xl border-0 p-0 shadow-2xl backdrop:bg-slate-900/60 backdrop:backdrop-blur-sm dark:bg-slate-900"
  >
    <div class="p-6 text-center">
      <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-linear-to-br from-pink-500 to-rose-500 text-white shadow-md shadow-pink-500/30">
        <Icon name="heart" size={22} strokeWidth={1.8} />
      </span>
      <h2 class="mt-4 text-lg font-bold text-slate-900 dark:text-white">
        Ayúdanos a mantener el sitio y a que más personas defiendan su bolsillo.
      </h2>
      <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
        Llave Bre-B, entidad Nubank:
      </p>

      <div class="mt-4 flex items-center justify-between gap-2 rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 dark:border-slate-700 dark:bg-slate-800">
        <span id="donate-key" class="font-mono text-base font-semibold text-slate-900 dark:text-white">@jov309</span>
        <button
          type="button"
          id="copy-donate-key"
          class="inline-flex shrink-0 items-center gap-1.5 rounded-lg bg-linear-to-br from-pink-500 to-rose-500 px-3 py-1.5 text-xs font-semibold text-white shadow-sm shadow-pink-500/30 transition-transform hover:scale-105"
        >
          <Icon name="copy" size={14} strokeWidth={2} />
          <span id="copy-donate-key-label">Copiar</span>
        </button>
      </div>

      <p class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-pink-600 dark:text-pink-400">
        <Icon name="heart" size={14} strokeWidth={2} />
        Gracias por tu aporte
      </p>

      <button
        type="button"
        id="close-donate-modal"
        class="mt-6 text-sm font-semibold text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200"
      >
        Cerrar
      </button>
    </div>
  </dialog>
</BaseLayout>

<script>
  const shortcutBtn = document.getElementById('copy-prompt-shortcut');
  const realCopyBtn = document.querySelector<HTMLButtonElement>('[data-copy-target="ai-prompt-home"]');
  const promptEl = document.getElementById('ai-prompt-home');

  shortcutBtn?.addEventListener('click', async () => {
    window.scrollBy({ top: 180, behavior: 'smooth' });

    if (!promptEl) return;
    try {
      await navigator.clipboard.writeText(promptEl.textContent ?? '');
      const original = shortcutBtn.textContent;
      shortcutBtn.textContent = '¡Copiado!';
      setTimeout(() => {
        shortcutBtn.textContent = original;
      }, 2000);
    } catch {
      realCopyBtn?.click();
    }
  });

  const modal = document.getElementById('donate-modal') as HTMLDialogElement | null;
  const openBtn = document.getElementById('open-donate-modal');
  const closeBtn = document.getElementById('close-donate-modal');
  const copyBtn = document.getElementById('copy-donate-key');
  const copyLabel = document.getElementById('copy-donate-key-label');
  const keyEl = document.getElementById('donate-key');

  openBtn?.addEventListener('click', () => modal?.showModal());
  closeBtn?.addEventListener('click', () => modal?.close());
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) modal.close();
  });

  copyBtn?.addEventListener('click', async () => {
    if (!keyEl || !copyLabel) return;
    try {
      await navigator.clipboard.writeText(keyEl.textContent ?? '');
      const original = copyLabel.textContent;
      copyLabel.textContent = '¡Copiado!';
      setTimeout(() => {
        copyLabel.textContent = original;
      }, 2000);
    } catch {
      copyLabel.textContent = 'No se pudo copiar';
    }
  });
</script>
