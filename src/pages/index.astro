---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import CopyBox from '../components/CopyBox.astro';
import DonateModal from '../components/DonateModal.astro';
import { AI_PROMPT } from '../data/ai-prompt';
import { SITE_NAME } from '../consts';

type LinkItem = { href: string; title: string; description: string; icon: IconName };

const featured: LinkItem[] = [
  {
    href: '/blog/caducidad-vs-prescripcion-multas-transito/',
    title: 'Caducidad vs. prescripción: la diferencia que más dinero te puede ahorrar',
    description: 'Son dos figuras distintas y casi nadie las explica bien. Aquí sabrás cuál aplica a tu caso.',
    icon: 'clock',
  },
  {
    href: '/blog/no-pagues-tu-multa-de-transito/',
    title: 'No pagues tu multa de tránsito sin hacer esto primero',
    description: 'Los 5 escenarios reales en los que la ley colombiana dice que no estás obligado a pagar.',
    icon: 'check-circle',
  },
  {
    href: '/blog/como-tumbar-una-multa-de-transito-en-colombia/',
    title: 'Cómo tumbar o anular una multa de tránsito',
    description: 'Guía rápida en 5 pasos: qué revisar primero y cuándo el proceso es rápido de verdad.',
    icon: 'shield-check',
  },
  {
    href: '/blog/simit-vs-runt-diferencias/',
    title: 'SIMIT: cómo consultar tu multa por placa o cédula',
    description: 'El paso a paso para consultar el portal oficial, y qué hacer con lo que encuentres antes de pagar.',
    icon: 'search',
  },
  {
    href: '/blog/que-es-el-cobro-coactivo-en-colombia/',
    title: '¿Qué es el cobro coactivo en Colombia?',
    description: 'Cómo funciona el proceso con el que el Estado cobra sin pasar por un juez, y tus opciones.',
    icon: 'lock',
  },
  {
    href: '/blog/caso-tumbar-multa-transito-mas-de-6-anos/',
    title: 'Caso ilustrativo: así se tumba una multa de más de 6 años',
    description: 'Derecho de petición, un segundo intento, tutela, y por qué al final se cayó el cobro.',
    icon: 'sparkles',
  },
];

const nextSteps: LinkItem[] = [
  {
    href: '/plantillas/',
    title: 'Plantillas gratis de derecho de petición y tutela',
    description: 'Si la IA te dice que tienes un argumento, aquí tienes el documento listo para llenar.',
    icon: 'document',
  },
  {
    href: '/blog/derecho-de-peticion-transito/',
    title: 'Cómo presentar el derecho de petición',
    description: 'A quién se lo envías, qué pedir y cuánto tiempo tienen para responderte.',
    icon: 'mail',
  },
  {
    href: '/blog/tutela-derecho-peticion-no-respondido/',
    title: 'Si no te responden: la tutela',
    description: 'Qué hacer cuando el organismo de tránsito ignora tu petición.',
    icon: 'scale',
  },
];

const title = SITE_NAME;
const description =
  'Antes de pagar tu multa de tránsito en Colombia, entiende tus opciones: prescripción, caducidad, fotomultas mal notificadas y derecho de petición. Guía gratuita y clara.';
---

<BaseLayout title={title} description={description}>
  <div class="relative isolate overflow-hidden">
    <!-- Decorative background: soft blue glow + faint dot grid -->
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[34rem] bg-linear-to-b from-blue-50 via-blue-50/40 to-transparent dark:from-blue-950/40 dark:via-blue-950/10"></div>
    <div aria-hidden="true" class="hero-dots pointer-events-none absolute inset-x-0 top-0 -z-10 h-[34rem] text-blue-200 dark:text-blue-900/60"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-32 -top-24 -z-10 h-96 w-96 rounded-full bg-blue-300/30 blur-3xl dark:bg-blue-700/20"></div>

    <section id="analiza" class="mx-auto max-w-2xl scroll-mt-6 px-4 pb-16 pt-10 sm:px-6 sm:pt-14">
      <h1 class="text-4xl font-extrabold leading-[1.1] tracking-tight text-slate-900 dark:text-white sm:text-5xl">
        Antes de{' '}
        <span class="text-red-600 line-through decoration-[3px] dark:text-red-400">pagar tu multa de tránsito</span>,{' '}
        <span class="text-green-600 dark:text-green-400">evalúa tus opciones.</span>
      </h1>

      <div class="mt-6 flex items-center gap-3 rounded-xl bg-yellow-400 px-4 py-3.5 text-slate-900 shadow-lg shadow-yellow-500/30 sm:px-5 sm:py-4">
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-slate-900 text-yellow-400">
          <Icon name="alert-triangle" size={22} strokeWidth={2.2} />
        </span>
        <p class="text-lg font-bold leading-snug sm:text-xl">
          No hagas acuerdos de pago ni te dejes presionar.
        </p>
      </div>

      <p class="mt-5 text-lg leading-relaxed text-slate-700 dark:text-slate-300">
        La ley te respalda, no necesitas abogado y la IA te ayuda gratis a revisar tu caso.
      </p>

      <div class="mt-8 overflow-hidden rounded-2xl border border-slate-300 bg-white shadow-xl shadow-slate-900/10 ring-4 ring-slate-100 dark:border-slate-700 dark:bg-slate-950 dark:ring-slate-900">
        <div class="flex items-center gap-2 border-b border-slate-200 bg-slate-900 px-5 py-3 text-white dark:bg-slate-800 dark:border-slate-800">
          <Icon name="robot" size={20} strokeWidth={2} />
          <p class="font-semibold">Analiza tu multa con IA en 3 pasos</p>
        </div>

        <ol class="relative p-5 text-base text-slate-700 dark:text-slate-300 sm:p-6">
          <span aria-hidden="true" class="absolute bottom-10 left-[2.15rem] top-10 w-px bg-slate-300 sm:left-[2.4rem] dark:bg-slate-700"></span>
          <li class="relative flex gap-3 pb-4">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-slate-900 text-sm font-bold text-white ring-4 dark:bg-white dark:text-slate-900 ring-white dark:ring-slate-950">1</span>
            <span class="pt-0.5">
              <strong class="text-slate-900 dark:text-white">Copia</strong> el{' '}
              <button type="button" id="copy-prompt-shortcut" class="font-semibold text-slate-900 underline decoration-2 underline-offset-2 hover:no-underline dark:text-white">prompt de abajo</button>.
            </span>
          </li>
          <li class="relative flex gap-3 pb-4">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-slate-900 text-sm font-bold text-white ring-4 dark:bg-white dark:text-slate-900 ring-white dark:ring-slate-950">2</span>
            <span class="pt-0.5"><strong class="text-slate-900 dark:text-white">Pégalo</strong> en ChatGPT, Gemini o Claude.</span>
          </li>
          <li class="relative flex gap-3">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-slate-900 text-sm font-bold text-white ring-4 dark:bg-white dark:text-slate-900 ring-white dark:ring-slate-950">3</span>
            <span class="pt-0.5">
              <strong class="text-slate-900 dark:text-white">Adjunta el pantallazo</strong> de tu registro en el{' '}
              <a href="https://www.fcm.org.co/simit/#/home-public" target="_blank" rel="noopener noreferrer" class="font-semibold text-slate-900 underline decoration-2 underline-offset-2 hover:no-underline dark:text-white">SIMIT</a>.
            </span>
          </li>
        </ol>

        <div class="border-t border-slate-200 bg-slate-50 p-4 dark:border-slate-800 dark:bg-slate-900/50 sm:p-5">
          <CopyBox id="ai-prompt-home" text={AI_PROMPT} maxHeight="max-h-48 sm:max-h-56" />
        </div>
      </div>

      <p class="mt-3 text-sm text-slate-600 dark:text-slate-400">
        100% gratis · sin registro · no reemplaza a un abogado en casos de alto valor.
      </p>

      <div class="mt-6 flex flex-col gap-4 rounded-2xl border border-pink-200 bg-linear-to-br from-pink-50 to-rose-50 p-5 sm:flex-row sm:items-center sm:justify-between dark:border-pink-900 dark:from-pink-950/40 dark:to-rose-950/20">
        <div class="flex gap-3">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-linear-to-br from-pink-500 to-rose-500 text-white shadow-md shadow-pink-500/30">
            <Icon name="heart" size={20} strokeWidth={2} />
          </span>
          <div>
            <p class="font-semibold text-slate-900 dark:text-white">¿Te ayudamos? Apóyanos</p>
            <p class="mt-0.5 text-sm leading-relaxed text-slate-700 dark:text-slate-300">
              Este sitio es gratis y se mantiene con donaciones. Cualquier aporte ayuda a más personas.
            </p>
          </div>
        </div>
        <button
          type="button"
          id="open-donate-modal"
          class="inline-flex shrink-0 items-center justify-center gap-2 rounded-xl bg-linear-to-br from-pink-500 to-rose-500 px-5 py-2.5 text-sm font-semibold text-white shadow-md shadow-pink-500/30 transition-transform hover:-translate-y-0.5"
        >
          <Icon name="heart" size={16} strokeWidth={2} />
          Donar
        </button>
      </div>

      <div class="mt-6 flex gap-3 rounded-xl border border-amber-200 bg-amber-50 p-4 dark:border-amber-900 dark:bg-amber-950/30">
        <Icon name="alert-triangle" size={20} class="mt-0.5 shrink-0 text-amber-600 dark:text-amber-400" />
        <p class="text-sm leading-relaxed text-amber-900 dark:text-amber-200">
          <strong>Una excepción honesta:</strong> si tu comparendo es por <strong>embriaguez o alcoholemia</strong>,
          esto no aplica igual. Hay una prueba técnica directa y consecuencias que van más allá de una multa
          administrativa, así que no recomendamos buscar defectos de forma. <strong>Consulta con un abogado.</strong>
        </p>
      </div>
    </section>
  </div>

  <section class="border-t border-slate-200 dark:border-slate-800">
    <div class="mx-auto max-w-2xl px-4 py-14 sm:px-6">
      <p class="text-sm font-semibold uppercase tracking-wider text-blue-700 dark:text-blue-400">Siguiente paso</p>
      <h2 class="mt-1 text-2xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-3xl">Después de la respuesta de la IA</h2>
      <p class="mt-2 text-base text-slate-700 dark:text-slate-300">
        Actúa dentro de los plazos legales: perderlos es lo que más le cuesta a la gente.
      </p>
      <ul class="mt-6 space-y-3">
        {
          nextSteps.map((item) => (
            <li>
              <a
                href={item.href}
                class="group flex items-start gap-4 rounded-xl border border-slate-200 bg-white p-4 transition-all hover:-translate-y-0.5 hover:border-blue-300 hover:shadow-md hover:shadow-blue-900/5 dark:border-slate-800 dark:bg-slate-900 dark:hover:border-blue-800"
              >
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-blue-50 text-blue-700 dark:bg-blue-950 dark:text-blue-300">
                  <Icon name={item.icon} size={20} strokeWidth={1.8} />
                </span>
                <span class="flex-1">
                  <span class="block font-semibold text-slate-900 group-hover:text-blue-700 dark:text-white dark:group-hover:text-blue-400">{item.title}</span>
                  <span class="mt-1 block text-base text-slate-600 dark:text-slate-400">{item.description}</span>
                </span>
                <Icon name="arrow-right" size={18} strokeWidth={2} class="mt-2.5 shrink-0 text-slate-400 transition-transform group-hover:translate-x-0.5 group-hover:text-blue-600" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="border-t border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-900/40">
    <div class="mx-auto max-w-2xl px-4 py-14 sm:px-6">
      <p class="text-sm font-semibold uppercase tracking-wider text-blue-700 dark:text-blue-400">Aprende más</p>
      <h2 class="mt-1 text-2xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-3xl">Los artículos más buscados</h2>
      <ul class="mt-6 divide-y divide-slate-200 border-y border-slate-200 dark:divide-slate-800 dark:border-slate-800">
        {
          featured.map((post) => (
            <li>
              <a href={post.href} class="group flex items-start gap-4 py-4">
                <span class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-white text-blue-700 ring-1 ring-slate-200 transition-colors group-hover:bg-blue-600 group-hover:text-white group-hover:ring-blue-600 dark:bg-slate-900 dark:text-blue-300 dark:ring-slate-700">
                  <Icon name={post.icon} size={18} strokeWidth={1.8} />
                </span>
                <span>
                  <span class="block font-semibold text-slate-900 group-hover:text-blue-700 dark:text-white dark:group-hover:text-blue-400">{post.title}</span>
                  <span class="mt-1 block text-base text-slate-600 dark:text-slate-400">{post.description}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3">
        <a href="/blog/" class="inline-flex items-center gap-1 font-semibold text-blue-700 hover:underline dark:text-blue-400">
          Ver todos los artículos
          <Icon name="arrow-right" size={16} strokeWidth={2} />
        </a>
        <a href="#analiza" class="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white shadow-md shadow-blue-600/20 hover:bg-blue-700">
          <Icon name="robot" size={18} strokeWidth={2} />
          Analizar mi multa con IA
        </a>
      </div>
    </div>
  </section>

  <button
    type="button"
    data-open-donate
    aria-label="Donar"
    class="fixed bottom-[calc(1rem+var(--cookie-offset,0px))] left-4 z-40 inline-flex items-center gap-2 rounded-full bg-linear-to-br from-pink-500 to-rose-500 py-3 pl-3 pr-4 text-sm font-semibold text-white shadow-lg shadow-pink-500/40 transition-all hover:-translate-y-0.5 hover:scale-105 sm:bottom-[calc(1.5rem+var(--cookie-offset,0px))] sm:left-6"
  >
    <Icon name="heart" size={20} strokeWidth={2.2} class="heart-beat" />
    Donar
  </button>

  <DonateModal />
</BaseLayout>

<style>
  .hero-dots {
    background-image: radial-gradient(currentColor 1px, transparent 1px);
    background-size: 22px 22px;
    mask-image: linear-gradient(to bottom, black, transparent);
    -webkit-mask-image: linear-gradient(to bottom, black, transparent);
  }

  @keyframes heart-beat {
    0%, 70%, 100% { transform: scale(1); }
    80% { transform: scale(1.25); }
    90% { transform: scale(0.95); }
  }
  :global(.heart-beat) {
    animation: heart-beat 2.4s ease-in-out infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.heart-beat) { animation: none; }
  }
</style>

<script>
  const shortcutBtn = document.getElementById('copy-prompt-shortcut');
  const realCopyBtn = document.querySelector<HTMLButtonElement>('[data-copy-target="ai-prompt-home"]');
  const promptEl = document.getElementById('ai-prompt-home');

  document.querySelector<HTMLAnchorElement>('a[href="#analiza"]')?.addEventListener('click', (event) => {
    event.preventDefault();
    document.getElementById('analiza')?.scrollIntoView({ behavior: 'smooth' });
  });

  shortcutBtn?.addEventListener('click', async () => {
    promptEl?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    if (!promptEl) return;
    try {
      await navigator.clipboard.writeText(promptEl.textContent ?? '');
      const original = shortcutBtn.textContent;
      shortcutBtn.textContent = '¡Copiado!';
      setTimeout(() => {
        shortcutBtn.textContent = original;
      }, 2000);
    } catch {
      realCopyBtn?.click();
    }
  });
</script>
