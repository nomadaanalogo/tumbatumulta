---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import DonateModal from '../../components/DonateModal.astro';
import { TEMPLATES } from '../../data/templates';

export async function getStaticPaths() {
  return TEMPLATES.map((tpl) => ({
    params: { slug: tpl.slug },
    props: { tpl },
  }));
}

const { tpl } = Astro.props;

const title = `${tpl.title} — plantilla gratis`;
const description = tpl.summary;
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <a
      href="/plantillas/"
      class="no-print inline-flex items-center gap-1 text-sm font-semibold text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200"
    >
      <Icon name="chevron-right" size={14} strokeWidth={2} class="rotate-180" />
      Todas las plantillas
    </a>

    <p class="no-print mt-4 inline-flex items-center gap-1.5 text-sm font-semibold uppercase tracking-wide text-green-700 dark:text-green-400">
      <Icon name={tpl.icon} size={16} strokeWidth={2} />
      {tpl.tipo} — gratis
    </p>
    <h1 class="mt-3 text-2xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-3xl">
      {tpl.title}
    </h1>

    <div class="no-print mt-6 rounded-2xl border border-slate-200 bg-slate-50 p-6 dark:border-slate-800 dark:bg-slate-900">
      <h2 class="font-bold text-slate-900 dark:text-white">¿Cuándo usar esta plantilla?</h2>
      <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400">{tpl.whoFor}</p>
    </div>

    <div class="no-print mt-5 rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-950">
      <h2 class="font-bold text-slate-900 dark:text-white">Qué necesitas antes de llenarla</h2>
      <ul class="mt-3 space-y-2">
        {
          tpl.requisitos.map((item) => (
            <li class="flex items-start gap-2 text-sm text-slate-700 dark:text-slate-300">
              <Icon name="check-circle" size={18} class="mt-0.5 shrink-0 text-green-600" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="no-print mt-8 flex items-center justify-between gap-3">
      <h2 class="font-bold text-slate-900 dark:text-white">El documento</h2>
      <button
        type="button"
        id="copy-template"
        class="inline-flex shrink-0 items-center gap-1.5 rounded-md bg-slate-900 px-3 py-1.5 text-xs font-semibold text-white transition-colors hover:bg-slate-800 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-200"
      >
        <Icon name="copy" size={14} strokeWidth={2} />
        <span id="copy-template-label">Copiar texto</span>
      </button>
    </div>

    <pre
      id="template-content"
      class="mt-3 overflow-x-auto whitespace-pre-wrap break-words rounded-2xl border border-slate-200 bg-slate-50 p-5 font-mono text-sm leading-relaxed text-slate-800 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-200"
      set:text={tpl.content}
    />

    <div class="no-print mt-6 text-center">
      <button
        id="open-donate-modal"
        type="button"
        class="inline-flex items-center gap-2 rounded-full bg-linear-to-r from-emerald-500 to-teal-500 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-emerald-500/25 transition-all hover:-translate-y-0.5 hover:shadow-xl hover:shadow-emerald-500/30"
      >
        <Icon name="document" size={18} strokeWidth={2} />
        Descargar / imprimir
      </button>
    </div>

    <div class="no-print mt-8 flex max-w-3xl gap-3 rounded-2xl border border-amber-200 bg-linear-to-br from-amber-50 to-orange-50 p-5 text-left shadow-sm shadow-amber-900/5 dark:border-amber-900 dark:from-amber-950/40 dark:to-orange-950/20">
      <Icon name="alert-triangle" size={22} class="mt-0.5 shrink-0 text-amber-600 dark:text-amber-400" />
      <p class="text-sm leading-relaxed text-amber-900 dark:text-amber-200">
        Esta plantilla es un punto de partida redactado con base en la normativa general y debe
        adaptarse a los hechos concretos de tu caso. No constituye asesoría legal individual ni
        garantiza un resultado favorable. Si tu comparendo es por <strong>alcoholemia o
        embriaguez</strong>, no aplica de la misma forma — consulta directamente con un abogado.
      </p>
    </div>
  </div>

  <DonateModal continueLabel="Descargar / imprimir" />
</BaseLayout>

<script>
  const copyBtn = document.getElementById('copy-template');
  const copyLabel = document.getElementById('copy-template-label');
  const contentEl = document.getElementById('template-content');

  copyBtn?.addEventListener('click', async () => {
    if (!contentEl || !copyLabel) return;
    try {
      await navigator.clipboard.writeText(contentEl.textContent ?? '');
      const original = copyLabel.textContent;
      copyLabel.textContent = '¡Copiado!';
      setTimeout(() => {
        copyLabel.textContent = original;
      }, 2000);
    } catch {
      copyLabel.textContent = 'No se pudo copiar';
    }
  });

  document.addEventListener('donate-modal-continue', () => {
    window.print();
  });
</script>
