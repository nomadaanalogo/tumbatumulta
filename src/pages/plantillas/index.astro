---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { TEMPLATES } from '../../data/templates';

const title = 'Plantillas gratis: derecho de petición y tutela para tu multa';
const description =
  'Cuatro plantillas gratis listas para llenar: comparendo prescrito, cobro coactivo prescrito, solicitar el expediente, y tutela por no respuesta. Sin registro, sin pago.';
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6">
    <a
      href="/"
      class="inline-flex items-center gap-1 text-sm font-semibold text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200"
    >
      <Icon name="chevron-right" size={14} strokeWidth={2} class="rotate-180" />
      Volver al inicio
    </a>

    <p class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold uppercase tracking-wide text-green-700 dark:text-green-400">
      <Icon name="document" size={16} strokeWidth={2} />
      100% gratis — sin registro
    </p>
    <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
      Plantillas gratis para tu multa
    </h1>
    <p class="mt-3 max-w-xl text-slate-600 dark:text-slate-300">
      Elige la que corresponda a tu caso, llena los datos, y radícala.
    </p>

    <div class="mt-8 grid gap-5 sm:grid-cols-2">
      {
        TEMPLATES.map((tpl) => (
          <a
            href={`/plantillas/${tpl.slug}/`}
            class="group flex flex-col gap-3 rounded-2xl border border-slate-200/70 bg-white p-6 shadow-sm shadow-slate-900/5 transition-all hover:-translate-y-0.5 hover:border-green-200 hover:shadow-lg hover:shadow-green-500/10 dark:border-slate-800 dark:bg-slate-900 dark:hover:border-green-900"
          >
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-linear-to-br from-emerald-400 to-teal-500 text-white shadow-sm shadow-emerald-500/30 transition-transform group-hover:scale-105">
                <Icon name={tpl.icon} size={20} strokeWidth={1.8} />
              </span>
              <span class="text-xs font-semibold uppercase tracking-wide text-slate-400 dark:text-slate-500">
                {tpl.tipo}
              </span>
            </div>
            <h2 class="font-bold text-slate-900 dark:text-white">{tpl.title}</h2>
            <p class="line-clamp-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400">{tpl.summary}</p>
            <span class="mt-auto inline-flex items-center gap-1 text-sm font-semibold text-green-700 dark:text-green-400">
              Ver y descargar
              <Icon name="arrow-right" size={14} strokeWidth={2} />
            </span>
          </a>
        ))
      }
    </div>

    <p class="mt-8 flex items-start gap-2 text-xs leading-relaxed text-slate-500 dark:text-slate-400">
      <Icon name="alert-triangle" size={14} class="mt-0.5 shrink-0 text-amber-500" />
      Son un punto de partida, no asesoría legal individual ni garantía de resultado. Si tu
      comparendo es por alcoholemia o embriaguez, consulta directamente con un abogado.
    </p>
  </div>
</BaseLayout>
