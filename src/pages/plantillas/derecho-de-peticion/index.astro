---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';

const wompiPublicKey = import.meta.env.PUBLIC_WOMPI_PUBLIC_KEY ?? '';

const title = 'Plantillas de derecho de petición para tu multa de tránsito';
const description =
  '5 plantillas de derecho de petición listas para llenar con tus datos y radicar: expediente de cobro coactivo, prescripción, caducidad, certificado de calibración y reiteración pre-tutela.';

const incluye = [
  'Solicitar copia del expediente de cobro coactivo',
  'Solicitar declaratoria de prescripción (más de 3 años)',
  'Solicitar declaratoria de caducidad (más de 1 año)',
  'Solicitar certificado de calibración de una fotomulta',
  'Reiterar una petición respondida de forma evasiva (antes de tutelar)',
];
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <p class="inline-flex items-center gap-1.5 text-sm font-semibold uppercase tracking-wide text-green-700 dark:text-green-400">
      <Icon name="document" size={16} strokeWidth={2} />
      Producto digital — descarga inmediata
    </p>
    <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
      {title}
    </h1>
    <p class="mt-4 text-lg leading-relaxed text-slate-600 dark:text-slate-300">
      Ya sabes qué necesitas pedir — no pierdas tiempo redactándolo desde cero. Cinco plantillas
      ya escritas con el fundamento legal correcto, listas para llenar con tu nombre y tus fechas.
    </p>

    <div class="mt-8 rounded-xl border border-slate-200 bg-slate-50 p-6 dark:border-slate-800 dark:bg-slate-900">
      <h2 class="font-bold text-slate-900 dark:text-white">Qué incluye</h2>
      <ul class="mt-4 space-y-2">
        {
          incluye.map((item) => (
            <li class="flex items-start gap-2 text-sm text-slate-700 dark:text-slate-300">
              <Icon name="check-circle" size={18} class="mt-0.5 shrink-0 text-green-600" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Si cambias el precio, actualízalo también en AMOUNT_IN_CENTS dentro de functions/api/crear-referencia.js -->
    <div class="mt-8 rounded-xl border border-green-200 bg-green-50 p-8 text-center dark:border-green-900 dark:bg-green-950/30">
      <p class="text-sm text-slate-600 dark:text-slate-400">Precio único, sin suscripción</p>
      <p class="mt-1 text-4xl font-extrabold text-slate-900 dark:text-white">$29.900 <span class="text-lg font-normal text-slate-500">COP</span></p>

      <button
        id="comprar-btn"
        type="button"
        class="mt-5 inline-flex items-center gap-2 rounded-md bg-green-600 px-8 py-3 text-base font-semibold text-white transition-colors hover:bg-green-700 disabled:cursor-not-allowed disabled:opacity-60"
      >
        <Icon name="lock" size={18} strokeWidth={2} />
        Comprar ahora
      </button>
      <div id="wompi-container" class="mt-4 flex justify-center"></div>
      <p id="comprar-error" class="mt-3 hidden text-sm text-red-600 dark:text-red-400"></p>

      <p class="mt-4 text-xs text-slate-500 dark:text-slate-400">
        Pago seguro procesado por Wompi (PSE, Nequi, tarjetas). Descarga disponible al instante
        después del pago.
      </p>
    </div>

    <div class="mt-8 rounded-xl border border-amber-300 bg-amber-50 p-5 dark:border-amber-800 dark:bg-amber-950/40">
      <p class="flex gap-2 text-sm leading-relaxed text-amber-900 dark:text-amber-200">
        <Icon name="alert-triangle" size={18} class="mt-0.5 shrink-0 text-amber-600 dark:text-amber-400" />
        <span>
          Esto es orientación informativa, no una asesoría legal individual, y no garantiza un
          resultado favorable. Si tu multa es por alcoholemia o el caso es de alto valor, consulta
          con un abogado. ¿Quieres primero entender tu caso antes de comprar? Usa el{' '}
          <a href="/analiza-tu-multa/" class="underline hover:no-underline">prompt de análisis con IA</a>{' '}
          gratis.
        </span>
      </p>
    </div>
  </div>

  <script is:inline define:vars={{ wompiPublicKey }}>
    const btn = document.getElementById('comprar-btn');
    const container = document.getElementById('wompi-container');
    const errorEl = document.getElementById('comprar-error');

    function showError(message) {
      if (!errorEl) return;
      errorEl.textContent = message;
      errorEl.classList.remove('hidden');
    }

    btn?.addEventListener('click', async () => {
      if (!wompiPublicKey) {
        showError('Los pagos todavía no están activados en este sitio. Intenta más tarde.');
        return;
      }

      btn.disabled = true;
      btn.textContent = 'Preparando pago...';

      try {
        const res = await fetch('/api/crear-referencia', { method: 'POST' });
        if (!res.ok) throw new Error('No se pudo iniciar el pago');
        const { reference, amountInCents, currency, signature } = await res.json();

        const script = document.createElement('script');
        script.src = 'https://checkout.wompi.co/widget.js';
        script.setAttribute('data-render', 'button');
        script.setAttribute('data-public-key', wompiPublicKey);
        script.setAttribute('data-currency', currency);
        script.setAttribute('data-amount-in-cents', String(amountInCents));
        script.setAttribute('data-reference', reference);
        script.setAttribute('data-signature:integrity', signature);
        script.setAttribute('data-redirect-url', `${window.location.origin}/plantillas/gracias/`);

        container?.appendChild(script);
        btn.classList.add('hidden');
      } catch (err) {
        btn.disabled = false;
        btn.textContent = 'Comprar ahora';
        showError('Hubo un problema iniciando el pago. Intenta de nuevo.');
      }
    });
  </script>
</BaseLayout>
